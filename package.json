{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "delphi-tools-raycast-extension",
  "description": "Wrapper for delphi tools",
  "license": "MIT",
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "icon": "extension-icon.png",
  "commands": [
    {
      "mode": "view",
      "name": "check-delphitools-install",
      "title": "Check delphitools Install",
      "description": "Check whether delphitools is installed"
    },
    {
      "mode": "view",
      "name": "delphi-tools",
      "title": "delphitools",
      "description": "Wrapper for delphitools"
    },
    {
      "mode": "view",
      "name": "encode",
      "title": "Encode Text",
      "description": "Encode text as base64 or URL encoding",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        },
        {
          "name": "encoding",
          "placeholder": "Encoding",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Base64",
              "value": "base64"
            },
            {
              "title": "URL",
              "value": "url"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "decode",
      "title": "Decode Text",
      "description": "Decode base64 or URL-encoded text",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        },
        {
          "name": "encoding",
          "placeholder": "Encoding",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Base64",
              "value": "base64"
            },
            {
              "title": "URL",
              "value": "url"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "hash",
      "title": "Hash Text",
      "description": "Hash text with MD5, SHA-1, SHA-256, or SHA-512",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        },
        {
          "name": "algorithm",
          "placeholder": "Algorithm",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "MD5",
              "value": "md5"
            },
            {
              "title": "SHA-1",
              "value": "sha1"
            },
            {
              "title": "SHA-256",
              "value": "sha256"
            },
            {
              "title": "SHA-512",
              "value": "sha512"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "contrast",
      "title": "Check Contrast",
      "description": "Check WCAG contrast ratio between foreground and background colours",
      "arguments": [
        {
          "name": "bg",
          "placeholder": "Background",
          "type": "text",
          "required": false
        },
        {
          "name": "fg",
          "placeholder": "Foreground",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "mode": "view",
      "name": "harmony",
      "title": "Generate Colour Harmony",
      "description": "Generate colour harmonies from a base colour",
      "arguments": [
        {
          "name": "colour",
          "placeholder": "Base Colour",
          "type": "text",
          "required": false
        },
        {
          "name": "harmonyType",
          "placeholder": "Harmony Type",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Complementary",
              "value": "complementary"
            },
            {
              "title": "Analogous",
              "value": "analogous"
            },
            {
              "title": "Triadic",
              "value": "triadic"
            },
            {
              "title": "Split-Complementary",
              "value": "split-complementary"
            },
            {
              "title": "Tetradic (Square)",
              "value": "tetradic"
            },
            {
              "title": "Monochromatic",
              "value": "monochromatic"
            },
            {
              "title": "Double Complementary",
              "value": "double-complementary"
            },
            {
              "title": "Compound",
              "value": "compound"
            },
            {
              "title": "Pentadic",
              "value": "pentadic"
            },
            {
              "title": "Analogous Accent",
              "value": "analogous-accent"
            },
            {
              "title": "Golden Ratio",
              "value": "golden"
            },
            {
              "title": "Near Complementary",
              "value": "near-complementary"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "colorblind",
      "title": "Simulate Colour Blindness",
      "description": "Simulate how a colour appears with colour blindness",
      "arguments": [
        {
          "name": "colour",
          "placeholder": "Colour",
          "type": "text",
          "required": false
        },
        {
          "name": "type",
          "placeholder": "Colour Blindness Type",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Normal",
              "value": "normal"
            },
            {
              "title": "Protanopia",
              "value": "protanopia"
            },
            {
              "title": "Deuteranopia",
              "value": "deuteranopia"
            },
            {
              "title": "Tritanopia",
              "value": "tritanopia"
            },
            {
              "title": "Protanomaly",
              "value": "protanomaly"
            },
            {
              "title": "Deuteranomaly",
              "value": "deuteranomaly"
            },
            {
              "title": "Tritanomaly",
              "value": "tritanomaly"
            },
            {
              "title": "Achromatopsia",
              "value": "achromatopsia"
            },
            {
              "title": "Achromatomaly",
              "value": "achromatomaly"
            }
          ]
        }
      ]
    }
  ],
  "title": "delphi-tools-raycast-extension",
  "author": "abeldebruijn",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Design Tools"
  ]
}
