{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "delphi-tools-raycast-extension",
  "description": "Run local design and text utilities from delphitools in Raycast",
  "license": "MIT",
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "icon": "extension-icon.png",
  "commands": [
    {
      "mode": "view",
      "name": "check-delphitools-install",
      "title": "Check Delphitools Install",
      "description": "Check whether delphitools is installed"
    },
    {
      "mode": "view",
      "name": "delphi-tools",
      "title": "Delphitools",
      "description": "Wrapper for delphitools"
    },
    {
      "mode": "view",
      "name": "encode",
      "title": "Encode Text",
      "description": "Encode text as base64 or URL encoding",
      "icon": "encode-icon.svg",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        },
        {
          "name": "encoding",
          "placeholder": "Encoding",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Base64",
              "value": "base64"
            },
            {
              "title": "URL",
              "value": "url"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "decode",
      "title": "Decode Text",
      "description": "Decode base64 or URL-encoded text",
      "icon": "decode-icon.svg",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        },
        {
          "name": "encoding",
          "placeholder": "Encoding",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Base64",
              "value": "base64"
            },
            {
              "title": "URL",
              "value": "url"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "hash",
      "title": "Hash Text",
      "description": "Hash text with MD5, SHA-1, SHA-256, or SHA-512",
      "icon": "hash-icon.svg",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        },
        {
          "name": "algorithm",
          "placeholder": "Algorithm",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "MD5",
              "value": "md5"
            },
            {
              "title": "SHA-1",
              "value": "sha1"
            },
            {
              "title": "SHA-256",
              "value": "sha256"
            },
            {
              "title": "SHA-512",
              "value": "sha512"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "contrast",
      "title": "Check Contrast",
      "description": "Check WCAG contrast ratio between foreground and background colors",
      "icon": "contrast-icon.svg",
      "arguments": [
        {
          "name": "bg",
          "placeholder": "Background",
          "type": "text",
          "required": false
        },
        {
          "name": "fg",
          "placeholder": "Foreground",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "mode": "view",
      "name": "harmony",
      "title": "Generate Color Harmony",
      "description": "Generate color harmonies from a base color",
      "icon": "harmony-icon.svg",
      "arguments": [
        {
          "name": "colour",
          "placeholder": "Base Color",
          "type": "text",
          "required": true
        },
        {
          "name": "harmonyType",
          "placeholder": "Harmony Type",
          "type": "dropdown",
          "required": true,
          "data": [
            {
              "title": "Complementary",
              "value": "complementary"
            },
            {
              "title": "Analogous",
              "value": "analogous"
            },
            {
              "title": "Triadic",
              "value": "triadic"
            },
            {
              "title": "Split-Complementary",
              "value": "split-complementary"
            },
            {
              "title": "Tetradic (Square)",
              "value": "tetradic"
            },
            {
              "title": "Monochromatic",
              "value": "monochromatic"
            },
            {
              "title": "Double Complementary",
              "value": "double-complementary"
            },
            {
              "title": "Compound",
              "value": "compound"
            },
            {
              "title": "Pentadic",
              "value": "pentadic"
            },
            {
              "title": "Analogous Accent",
              "value": "analogous-accent"
            },
            {
              "title": "Golden Ratio",
              "value": "golden"
            },
            {
              "title": "Near Complementary",
              "value": "near-complementary"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "colorblind",
      "title": "Simulate Color Blindness",
      "description": "Simulate how a color appears with color blindness",
      "icon": "colorblind-icon.svg",
      "arguments": [
        {
          "name": "colour",
          "placeholder": "Color",
          "type": "text",
          "required": true
        },
        {
          "name": "type",
          "placeholder": "Color Blindness Type",
          "type": "dropdown",
          "required": true,
          "data": [
            {
              "title": "Normal",
              "value": "normal"
            },
            {
              "title": "Protanopia",
              "value": "protanopia"
            },
            {
              "title": "Deuteranopia",
              "value": "deuteranopia"
            },
            {
              "title": "Tritanopia",
              "value": "tritanopia"
            },
            {
              "title": "Protanomaly",
              "value": "protanomaly"
            },
            {
              "title": "Deuteranomaly",
              "value": "deuteranomaly"
            },
            {
              "title": "Tritanomaly",
              "value": "tritanomaly"
            },
            {
              "title": "Achromatopsia",
              "value": "achromatopsia"
            },
            {
              "title": "Achromatomaly",
              "value": "achromatomaly"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "simulate-colour-blindness-image",
      "title": "Simulate Color Blindness (Image)",
      "description": "Simulate how an image appears with color blindness",
      "icon": "colorblind-icon.svg"
    },
    {
      "mode": "view",
      "name": "barcode",
      "title": "Generate Barcode",
      "description": "Generate a barcode image from text",
      "icon": "barcode-icon.svg"
    },
    {
      "mode": "view",
      "name": "clip",
      "title": "Trim Transparent Edges",
      "description": "Trim transparent edges from PNG images",
      "icon": "clip-icon.svg"
    },
    {
      "mode": "view",
      "name": "convert",
      "title": "Convert Images",
      "description": "Convert images between formats with optional resize",
      "icon": "convert-icon.svg"
    },
    {
      "mode": "view",
      "name": "favicon",
      "title": "Favicon Generator",
      "description": "Generate multi-size favicon files from an image",
      "icon": "favicon-icon.svg"
    },
    {
      "mode": "view",
      "name": "crop",
      "title": "Social Media Cropper",
      "description": "Crop images to a social media aspect ratio",
      "icon": "crop-icon.svg"
    },
    {
      "mode": "view",
      "name": "impose",
      "title": "Print Imposer",
      "description": "Impose a PDF for booklet or n-up printing",
      "icon": "impose-icon.svg"
    },
    {
      "mode": "view",
      "name": "matte",
      "title": "Matte Generator",
      "description": "Place images on a square or aspect-ratio matte",
      "icon": "matte-icon.svg"
    },
    {
      "mode": "view",
      "name": "meta",
      "title": "Meta Tag Generator",
      "description": "Generate HTML meta tags",
      "icon": "meta-icon.svg"
    },
    {
      "mode": "view",
      "name": "tailwind-shades",
      "title": "Generate Tailwind Shades",
      "description": "Generate Tailwind CSS color shades from a base color",
      "icon": "tailwind-shades-icon.svg",
      "arguments": [
        {
          "name": "colour",
          "placeholder": "Base Color",
          "type": "text",
          "required": true
        },
        {
          "name": "mode",
          "placeholder": "Generation Mode",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "Classic",
              "value": "classic"
            },
            {
              "title": "Vivid",
              "value": "vivid"
            },
            {
              "title": "Muted",
              "value": "muted"
            },
            {
              "title": "Hue Shift",
              "value": "hue-shift"
            }
          ]
        }
      ]
    },
    {
      "mode": "view",
      "name": "line-height",
      "title": "Compute Line Height",
      "description": "Compute named line-height ratios for a font size",
      "icon": "line-height-icon.svg",
      "arguments": [
        {
          "name": "fontSize",
          "placeholder": "Font Size",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "mode": "view",
      "name": "paper",
      "title": "Paper Sizes",
      "description": "Look up paper size dimensions",
      "icon": "paper-icon.svg",
      "arguments": [
        {
          "name": "name",
          "placeholder": "Paper Size",
          "type": "text",
          "required": false
        }
      ]
    },
    {
      "mode": "view",
      "name": "font-info",
      "title": "Font File Explorer",
      "description": "Inspect metadata from TTF, OTF, WOFF, or WOFF2 font files",
      "icon": "font-info-icon.svg"
    },
    {
      "mode": "view",
      "name": "shavian",
      "title": "Transliterate to Shavian",
      "description": "Transliterate English text to the Shavian alphabet",
      "icon": "shavian-icon.svg",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "title": "Delphitools",
  "author": "abeldebruijn",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Productivity",
    "Design Tools"
  ]
}
